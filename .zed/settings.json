{
  "languages": {
    "Rust": {
      "language_servers": ["rust-analyzer"],
      "formatter": "language_server",
      "format_on_save": "on"
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "checkOnSave": true,
        "check": {
          "command": "clippy"
        }
      }
    }
  }
}
